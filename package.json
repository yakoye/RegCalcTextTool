{
  "name": "reg-calc-text-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Static RegCalc and TextFormatter tool for Cloudflare Pages and GitHub Pages.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-static.js",
    "preview": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "he": "1.2.0",
    "js-yaml": "5.2.2",
    "marked": "18.0.7",
    "mathjs": "^15.2.0",
    "papaparse": "5.5.4",
    "sax": "1.6.1",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "wrangler": "4.125.0"
  }
}
